{
    "name": "@erosire/create-storyline",
    "version": "1.0.2",
    "description": "Scaffold a new Storyline project — minimal TypeScript starter initializer for npm create @erosire/storyline",
    "type": "module",
    "bin": {
        "create-storyline": "./bin/create-storyline.js"
    },
    "files": [
        "bin",
        "template"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "release": "vite-node ../../../scripts/publish-safe.ts",
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "start": "vite-node src/server/cli.ts",
        "start:prod": "vite build && vite-node src/server/cli.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/erosire/create-storyline.git"
    },
    "author": "erosire",
    "license": "MIT",
    "dependencies": {
        "@presource/core": "*",
        "@presource/react": "*",
        "@rightless/icons": "*",
        "@underload/dashboard": "*",
        "@underload/harness": "*",
        "@underload/service": "*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "jsdom": "^29.0.2",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.4"
    }
}
